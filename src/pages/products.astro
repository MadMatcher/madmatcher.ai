---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRODUCTS, PRO, REALTIME, CONSULTING, CITATION, SOCIAL, CONTACT } from '../consts';
import { breadcrumbSchema, softwareSchema } from '../lib/schema';

const crumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products' },
]);

// Mechanics drawn directly from each repo's README. 3 bullets each for even cards.
const detail: Record<string, { points: string[]; cite?: boolean }> = {
  sparkly: {
    points: [
      'Top-k TF/IDF candidate generation (BM25 via Lucene)',
      'Indexes the smaller table, searches it with the other on Spark',
      'Scales to hundreds of millions of tuples per table',
    ],
    cite: true,
  },
  delex: {
    points: [
      'Combine TF/IDF, dictionary blockers, and custom rules',
      'Write blocking as one declarative program',
      'Compiles to an optimized Spark DAG',
    ],
  },
  matchflow: {
    points: [
      'Trains a classifier (XGBoost, Random Forest, …) on labeled pairs',
      'Active learning labels a small sample, about 600 pairs',
      'Runs on pandas or Spark (single machine or cluster)',
    ],
  },
};
---

<BaseLayout
  title="Products"
  description="The MadMatcher toolkit: Sparkly and Delex for blocking, MatchFlow for matching, plus MadMatcher-Pro for production reliability and real-time serving, and hands-on consulting."
  schemas={[crumbs, softwareSchema()]}
>
  <PageHero
    title="MadMatcher in production."
    lead="MadMatcher-Pro and consulting take entity matching to production, on top of an open-source core. Pro adds reliability for long-running jobs and real-time serving for records that arrive one at a time; consulting brings the team onto your data. Underneath sit three open-source tools you can also run yourself."
  >
    <a slot="actions" href={CONTACT.calendar} class="btn btn-primary" target="_blank" rel="noopener">Book a call</a>
    <a slot="actions" href={SOCIAL.github} class="btn btn-ghost" target="_blank" rel="noopener">GitHub org</a>
  </PageHero>

  <!-- ===================== PRO + CONSULTING ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Take it to production.</h2>
        <p class="lead">MadMatcher-Pro adds the reliability a long-running job needs, and supports semantic/fusion blocking + matching; the real-time add-on serves single-record matches in milliseconds; consulting brings the team onto your data. The fastest path from a prototype to a production matching pipeline.</p>
      </div>
      <div class="grid grid-2">
        <div class="card offer offer-pro">
          <div class="offer-top">
            <h3>{PRO.name}</h3>
          </div>
          <p class="offer-desc">{PRO.description}</p>
          <div class="offer-features">
            <span class="offer-features-label">Included</span>
            <ul class="ticks">{PRO.features.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div class="offer-actions offer-cta">
            <a href="/contact" class="btn btn-accent btn-sm">Get in touch about Pro</a>
            <a href={PRO.docs} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">API docs</a>
          </div>
        </div>

        <div class="card offer offer-realtime">
          <div class="offer-badge">Pro add-on</div>
          <div class="offer-top">
            <h3>{REALTIME.name}</h3>
          </div>
          <p class="offer-desc">{REALTIME.description}</p>
          <div class="offer-features">
            <span class="offer-features-label">Included</span>
            <ul class="ticks">{REALTIME.features.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div class="offer-actions offer-cta">
            <a href="/contact" class="btn btn-accent btn-sm">Get in touch about real-time</a>
            <a href={REALTIME.docs} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">API docs</a>
          </div>
        </div>
      </div>

      <div class="card offer-consulting">
        <div class="consult-copy">
          <h3>{CONSULTING.name}</h3>
          <p class="offer-desc">{CONSULTING.description}</p>
        </div>
        <a href={CONTACT.calendar} target="_blank" rel="noopener" class="btn btn-primary">Book a call</a>
      </div>
    </div>
  </section>

  <!-- ===================== OPEN-SOURCE CORE ===================== -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <h2>The open-source core.</h2>
        <p class="lead">The three tools underneath, free and open source. Sparkly and Delex do blocking, MatchFlow does matching. Use one on its own or chain them into a full pipeline.</p>
      </div>
      <div class="grid grid-3">
        {
          PRODUCTS.map((p) => (
            <article class="card tool" id={p.slug}>
              <div class="tool-tag">{p.role}</div>
              <h3>{p.name}</h3>
              <p class="tool-summary">{p.summary}</p>
              <ul class="ticks tool-points">
                {detail[p.slug].points.map((pt) => <li>{pt}</li>)}
              </ul>
              <div class="tool-foot">
                {detail[p.slug].cite && (
                  <p class="tool-cite">
                    {CITATION.short}. Outperforms eight state-of-the-art blockers.{' '}
                    <a href={CITATION.url} target="_blank" rel="noopener">Read the paper ↗</a>
                  </p>
                )}
                <div class="tool-links">
                  <a href={p.github} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">GitHub</a>
                  {p.docs && <a href={p.docs} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">API docs</a>}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand heading="See it on your data." blurb="Book a call to scope your matching problem with the team, or explore the tools and run the quickstart yourself." />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Pro interest click (scoped to the Pro offer card)
    document.querySelectorAll('.offer-pro a[href="/contact"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('pro_interest_clicked');
      });
    });

    // Real-time add-on interest click (scoped to the add-on card)
    document.querySelectorAll('.offer-realtime a[href="/contact"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('realtime_interest_clicked');
      });
    });

    // Consulting: book a call from products page
    document.querySelectorAll('.offer-consulting a[href*="calendar.app.google"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('book_call_clicked', { source: 'products_consulting' });
      });
    });

    // Per-tool GitHub and docs links
    document.querySelectorAll('.tool').forEach(function (card) {
      var toolSlug = card.id;
      card.querySelectorAll('.tool-links a[href*="github.com"]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('github_clicked', { source: 'product_' + toolSlug, tool: toolSlug });
        });
      });
      card.querySelectorAll('.tool-links a[href*="docs.madmatcher.ai"]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('product_docs_clicked', { tool: toolSlug });
        });
      });
    });

    // Research paper link on products page
    document.querySelectorAll('.tool-cite a[href*="sparkly-vldb"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('research_paper_clicked');
      });
    });
  });
</script>

<style>
  /* ---------- tool cards (uniform) ---------- */
  .tool {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .tool-tag {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--red);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .tool h3 {
    font-size: var(--text-xl);
  }
  .tool-summary {
    color: var(--ink-soft);
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-sm);
  }
  .tool-points {
    margin-bottom: var(--space-5);
  }
  .tool-points li {
    font-size: var(--text-sm);
  }
  /* footer pinned to the bottom so cards line up */
  .tool-foot {
    margin-top: auto;
  }
  .tool-cite {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .tool-cite a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tool-links {
    display: flex;
    gap: var(--space-2);
  }
  .btn-sm {
    padding: 0.5rem 0.9rem;
    font-size: var(--text-sm);
  }

  /* ---------- offers ---------- */
  .offer {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }
  .offer-pro,
  .offer-realtime {
    border-top: 3px solid var(--red);
  }
  .offer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .offer-top h3 {
    font-size: var(--text-xl);
  }
  .offer-badge {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--red);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  /* ---------- consulting (wide card under the offers) ---------- */
  .offer-consulting {
    margin-top: var(--space-6);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-8);
  }
  .offer-consulting h3 {
    font-size: var(--text-xl);
  }
  .offer-consulting .offer-desc {
    margin: var(--space-3) 0 0;
    max-width: 64ch;
  }
  @media (max-width: 820px) {
    .offer-consulting {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      justify-items: start;
    }
  }
  .offer-desc {
    color: var(--ink-soft);
    margin: var(--space-4) 0 var(--space-8);
  }
  .offer-features {
    margin-bottom: var(--space-8);
  }
  .offer-features-label {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .offer-cta {
    align-self: flex-start;
    margin-top: auto;
  }
  .offer-actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
</style>
