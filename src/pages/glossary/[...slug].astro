---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/prose.css';
import { breadcrumbSchema, definedTermSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const terms = await getCollection('glossary', ({ data }) => !data.draft);
  return terms.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const term = definedTermSchema({
  term: entry.data.term,
  definition: entry.data.definition,
  url: `/glossary/${entry.id}`,
});

// A single-question FAQ ("What is X?") makes the definition extractable by AI engines.
const faq = faqSchema([
  { question: `What is ${entry.data.term.toLowerCase()}?`, answer: entry.data.definition },
]);

const crumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary' },
  { name: entry.data.term, path: `/glossary/${entry.id}` },
]);
---

<BaseLayout
  title={`${entry.data.term}: definition`}
  description={entry.data.definition}
  image={`/og/glossary/${entry.id}.png`}
  schemas={[crumbs, term, faq]}
>
  <article class="section">
    <div class="container container-narrow">
      <a href="/glossary" class="back mono">← Glossary</a>
      <h1 class="g-term">{entry.data.term}</h1>
      {entry.data.aka.length > 0 && (
        <div class="g-aka mono">also called {entry.data.aka.join(', ')}</div>
      )}
      <p class="g-def">{entry.data.definition}</p>
      <div class="prose g-body"><Content /></div>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .back {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .back:hover {
    color: var(--red);
  }
  .g-term {
    margin-top: var(--space-4);
  }
  .g-aka {
    color: var(--red);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }
  .g-def {
    font-size: var(--text-xl);
    color: var(--ink);
    line-height: 1.5;
    border-left: 3px solid var(--red);
    padding-left: var(--space-4);
    margin-top: var(--space-6);
  }
  .g-body {
    margin-top: var(--space-8);
  }
</style>
