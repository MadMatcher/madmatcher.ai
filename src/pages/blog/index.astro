---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import { breadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const crumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
]);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Blog: entity matching, at depth"
  description="Technical guides and deep dives on entity matching, record linkage, blocking, active learning, and resolving data at scale, from the team building MadMatcher."
  schemas={[crumbs]}
>
  <PageHero
    title="Notes on entity matching."
    lead="Guides on how blocking and matching work, and on resolving data at scale."
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 && (
        <p class="muted">First posts are on the way. <a href="/contact" style="color:var(--red)">Subscribe</a> to get them.</p>
      )}

      {posts.length > 0 && (
        <div class="post-grid">
          {posts.map((p) => (
            <a href={`/blog/${p.id}/`} class="post-card card card-hover">
              <h3>{p.data.title}</h3>
              <p class="muted mt-2">{p.data.description}</p>
              <div class="post-meta mono mt-4">
                <span>{p.data.author}</span><span aria-hidden="true">·</span>
                <time>{fmt(p.data.pubDate)}</time>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="container"><Newsletter /></div>
  </section>
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .post-card {
    display: flex;
    flex-direction: column;
  }
  .post-card h3 {
    font-size: var(--text-lg);
    margin-top: var(--space-3);
  }
  .post-card .muted {
    flex: 1;
  }
  .post-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .tag {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .post-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
