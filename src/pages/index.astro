---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SOCIAL, CONTACT, PRODUCTS, CITATION } from '../consts';
import { softwareSchema } from '../lib/schema';

// Illustrative hero visual: records matched across two tables. Three correct matches
// and one look-alike pair (Acme Robotics vs Acme Logistics) the matcher correctly rejects.
const pairs = [
  { a: 'Robert A. Smith', aSub: 'Acme Inc.', b: 'Bob Smith', bSub: 'ACME, Inc.', match: true },
  { a: 'Jennifer Nguyen', aSub: 'Globex Corp.', b: 'Jenn Nguyen', bSub: 'Globex Corporation', match: true },
  { a: 'Michael O’Brien', aSub: 'Initech', b: 'Mike O’Brien', bSub: 'Initech LLC', match: true },
  { a: 'Acme Robotics', aSub: 'Austin, TX', b: 'Acme Logistics', bSub: 'Austin, TX', match: false },
];

const applied = [
  { t: 'Academic benchmarks', d: 'Product, music, and citation matching datasets.' },
  { t: 'Environmental ontologies', d: 'Concept and entity matching across environmental schemas.' },
  { t: 'Sanctions & watchlists', d: 'OFAC SDN and UN Security Council consolidated lists.' },
  { t: 'Government contractor data', d: 'Resolving contractor entities across aliases and changing firm affiliations.' },
];

const benefits = [
  { title: 'Trained to your domain', body: 'MatchFlow learns a matcher from your labeled data with active learning. About 600 labels fit it to your domain, instead of a fixed pretrained model.' },
  { title: 'Runs in your infrastructure', body: 'Executes in your own Spark or single-machine environment. Your data never leaves your perimeter.' },
  { title: 'Scales to your hardest tables', body: 'Blocking runs share-nothing on Apache Spark and handles hundreds of millions of records per table.' },
  { title: 'Benchmarked blocking', body: 'Sparkly’s method is peer-reviewed and outperforms eight state-of-the-art blockers.' },
  { title: 'Fits your stack', body: 'Use one tool or the whole pipeline. It runs inside the stack you already have instead of making you adopt a new platform.' },
  { title: 'Two clear, tunable parts', body: 'Blocking and matching are separate stages you can tune and measure independently.' },
];

const blocking = PRODUCTS.filter((p) => p.step === 'Blocking');
const matching = PRODUCTS.filter((p) => p.step === 'Matching');
---

<BaseLayout title="Scalable & Accurate Entity Matching" schemas={[softwareSchema()]}>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Scalable &amp; Accurate Entity Matching</h1>
        <p class="hero-sub">Blocking that beats the state of the art. A matcher you train on your own data.</p>
        <p class="hero-lead">
          Resolve the records that point to the same real-world entity across large, messy
          datasets, inside your own infrastructure.
        </p>
        <div class="btn-row hero-cta">
          <a href={CONTACT.calendar} class="btn btn-primary" target="_blank" rel="noopener">Book a call</a>
          <a href={SOCIAL.github} class="btn btn-ghost" target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="match-panel" role="img" aria-label="Example of records matched across two tables: three correct matches and one look-alike pair correctly rejected.">
          <div class="mp-head">
            <span>Matches across two tables</span>
          </div>
          {
            pairs.map((p) => (
              <div class:list={['mp-row', { 'is-no': !p.match }]}>
                <div class="mp-rec">
                  <span class="mp-name">{p.a}</span>
                  <span class="mp-meta">{p.aSub}</span>
                </div>
                {p.match ? (
                  <span class="mp-link is-match" aria-hidden="true">
                    <svg viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 12h36" />
                      <path d="M10 6 4 12l6 6" />
                      <path d="M34 6l6 6-6 6" />
                    </svg>
                  </span>
                ) : (
                  <span class="mp-link is-nomatch" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                      <path d="M7 7l10 10M17 7 7 17" />
                    </svg>
                  </span>
                )}
                <div class="mp-rec mp-rec-b">
                  <span class="mp-name">{p.b}</span>
                  <span class="mp-meta">{p.bSub}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ========================== APPLIED TO ========================== -->
  <section class="section-tight section-soft">
    <div class="container">
      <h2 class="strip-label">Applied to demanding, real-world data</h2>
      <div class="applied">
        {
          applied.map((a) => (
            <div class="applied-item">
              <h3>{a.t}</h3>
              <p class="muted">{a.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== THE PROBLEM ========================== -->
  <section class="section">
    <div class="container container-narrow center-block">
      <h2>Rules and pretrained models miss your matches.</h2>
      <p class="lead mt-4">
        Most ways to match records use hand-authored rules or a fixed pretrained model.
        Rules turn into a long list of exceptions you keep adding to, and a pretrained
        model has never seen your data, so both miss real matches and pass false ones on
        messy records. MadMatcher learns a matcher from your own labeled data, so it fits
        the way your records actually vary.
      </p>
      <p class="mt-6"><a href="/why-madmatcher" class="link-arrow">Why MadMatcher trains to your data <span>→</span></a></p>
    </div>
  </section>

  <!-- ============================ BENEFITS ============================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <h2>Accurate matching you control.</h2>
      </div>
      <div class="benefits">
        {
          benefits.map((b) => (
            <div class="benefit">
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ THE TOOLS ============================ -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2>The open-source toolkit.</h2>
        <p class="lead">
          Two steps, three tools. Blocking narrows the full pairwise space to a handful of
          candidate pairs. Matching then labels each pair a match or not.
        </p>
      </div>

      <div class="pipeline">
        <div class="stage">
          <div class="stage-head"><span class="stage-num">1</span><span class="stage-name">Blocking</span></div>
          <div class="stage-tools">
            {
              blocking.map((p) => (
                <a href={`/products#${p.slug}`} class="ptool">
                  <span class="ptool-name">{p.name}</span>
                  <span class="ptool-role">{p.role}</span>
                </a>
              ))
            }
          </div>
          <p class="stage-note">Narrow two tables to a small set of candidate pairs.</p>
        </div>

        <div class="pipeline-arrow" aria-hidden="true">→</div>

        <div class="stage">
          <div class="stage-head"><span class="stage-num">2</span><span class="stage-name">Matching</span></div>
          <div class="stage-tools">
            {
              matching.map((p) => (
                <a href={`/products#${p.slug}`} class="ptool">
                  <span class="ptool-name">{p.name}</span>
                  <span class="ptool-role">{p.role}</span>
                </a>
              ))
            }
          </div>
          <p class="stage-note">Classify each candidate pair as a match or not.</p>
        </div>
      </div>

      <p class="tools-more">
        Need it in production? <a href="/products">MadMatcher-Pro and consulting →</a>
      </p>
    </div>
  </section>

  <!-- ============================ RESEARCH ============================ -->
  <section class="section-tight">
    <div class="container center-block">
      <p class="research-text">
        The blocking method behind MadMatcher was introduced and benchmarked in a
        peer-reviewed paper at VLDB 2023.
      </p>
      <a href={CITATION.url} target="_blank" rel="noopener" class="btn btn-ghost btn-sm research-btn">Read the paper ↗</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    padding-block: clamp(var(--space-16), 7vw, var(--space-24)) clamp(var(--space-12), 5vw, var(--space-16));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(2.1rem, 1.2rem + 3vw, 2.9rem);
  }
  .hero-sub {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.35;
    font-weight: 600;
    color: var(--ink);
    max-width: 34ch;
  }
  .hero-lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .hero-cta {
    margin-top: var(--space-8);
  }

  /* ---------------- hero visual: match panel ---------------- */
  .hero-visual {
    min-width: 0;
  }
  .match-panel {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .mp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted);
  }
  .mp-row {
    display: grid;
    grid-template-columns: 1fr 56px 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .mp-row:last-child {
    border-bottom: none;
  }
  .mp-row.is-no {
    background: var(--bg-soft);
  }
  .mp-rec {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mp-rec-b {
    text-align: right;
  }
  .mp-name {
    font-weight: 560;
    font-size: var(--text-sm);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-meta {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-link {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mp-link svg {
    height: 24px;
  }
  .mp-link.is-match {
    color: var(--red);
  }
  .mp-link.is-match svg {
    width: 44px;
  }
  .mp-link.is-nomatch {
    color: var(--faint);
  }
  .mp-link.is-nomatch svg {
    width: 22px;
    height: 22px;
  }

  /* ---------------- applied strip ---------------- */
  .strip-label {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .applied {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }
  .applied-item {
    border-left: 2px solid var(--red);
    padding-left: var(--space-4);
  }
  .applied-item h3 {
    font-size: var(--text-lg);
  }
  .applied-item p {
    font-size: var(--text-base);
    margin-top: var(--space-1);
  }

  /* ---------------- problem ---------------- */
  .center-block {
    text-align: center;
  }
  .center-block .lead {
    margin-inline: auto;
  }
  .link-arrow {
    font-weight: 560;
    color: var(--ink);
  }
  .link-arrow span {
    color: var(--red);
  }
  .link-arrow:hover {
    color: var(--red);
  }

  /* ---------------- benefits (editorial) ---------------- */
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8) var(--space-12);
  }
  .benefit {
    border-top: 2px solid var(--red);
    padding-top: var(--space-4);
  }
  .benefit h3 {
    font-size: var(--text-lg);
  }
  .benefit p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  /* ---------------- tools pipeline ---------------- */
  .pipeline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: stretch;
  }
  .stage {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .stage-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .stage-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--red-tint);
    color: var(--red);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .stage-name {
    font-size: var(--text-lg);
    font-weight: 680;
    letter-spacing: -0.01em;
  }
  .stage-tools {
    display: flex;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    flex-wrap: wrap;
  }
  .ptool {
    flex: 1;
    min-width: 130px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-soft);
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .ptool:hover {
    border-color: var(--red);
    background: #fff;
  }
  .ptool-name {
    font-weight: 600;
  }
  .ptool-role {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .stage-note {
    margin-top: auto;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
  .pipeline-arrow {
    align-self: center;
    color: var(--red);
    font-size: 1.6rem;
  }

  .tools-more {
    margin-top: var(--space-8);
    text-align: center;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .tools-more a {
    color: var(--ink);
    font-weight: 560;
  }
  .tools-more a:hover {
    color: var(--red);
  }

  /* ---------------- research ---------------- */
  .research-text {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-inline: auto;
  }
  .research-btn {
    margin-top: var(--space-4);
  }
  .btn-sm {
    padding: 0.5rem 0.9rem;
    font-size: var(--text-sm);
  }

  /* ---------------- responsive ---------------- */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .applied {
      grid-template-columns: 1fr 1fr;
    }
    .benefits {
      grid-template-columns: 1fr 1fr;
    }
    .pipeline {
      grid-template-columns: 1fr;
    }
    .pipeline-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
  @media (max-width: 620px) {
    .applied {
      grid-template-columns: 1fr;
    }
    .benefits {
      grid-template-columns: 1fr;
    }
    .stage-tools {
      flex-direction: column;
    }
  }
</style>
