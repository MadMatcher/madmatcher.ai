---
/**
 * Shared layout for legal documents (privacy policy, terms). Renders a narrow
 * prose column with a title and "last updated" stamp. Indexable by default —
 * legal pages are fine for crawlers to see.
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Human-readable last-updated date, e.g. "June 9, 2026". */
  updated: string;
}

const { title, description, updated } = Astro.props;

const crumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: title, path: Astro.url.pathname },
]);
---

<BaseLayout title={title} description={description} schemas={[crumbs]}>
  <header class="legal-header">
    <div class="container container-narrow">
      <h1>{title}</h1>
      <p class="legal-updated mono">Last updated: {updated}</p>
    </div>
  </header>

  <div class="container container-narrow legal-body">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .legal-header {
    padding-block: clamp(var(--space-12), 6vw, var(--space-24)) var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .legal-header h1 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, var(--text-4xl));
  }
  .legal-updated {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .legal-body {
    padding-block: var(--space-12);
  }
  .legal-body .prose {
    margin-inline: auto;
  }
</style>
