---
interface Props {
  title: string;
  lead?: string;
  /** Use a narrow container — only for prose pages whose body is also narrow. */
  narrow?: boolean;
}
const { title, lead, narrow = false } = Astro.props;
---

<section class="page-hero">
  <div class:list={['container', { 'container-narrow': narrow }]}>
    <h1>{title}</h1>
    {lead && <p class="lead mt-6">{lead}</p>}
    <div class="page-hero-actions">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24)) var(--space-12);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .page-hero .lead {
    max-width: 64ch;
  }
  .page-hero-actions:not(:empty) {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
