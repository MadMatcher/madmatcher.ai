---
import { SITE, SOCIAL, CONTACT } from '../consts';
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Products', href: '/products' },
      { label: 'How it works', href: '/how-it-works' },
      { label: 'Why MadMatcher', href: '/why-madmatcher' },
      { label: 'Use cases', href: '/use-cases' },
      { label: 'Compare approaches', href: '/compare' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { label: 'Docs & quickstart', href: '/docs' },
      { label: 'Glossary', href: '/glossary' },
      { label: 'For AI assistants', href: '/llm-info' },
      { label: 'GitHub', href: SOCIAL.github, external: true },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Team', href: '/about/team' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <img src="/logo-mark.svg" alt="" class="brand-mark-img" width="26" height="26" />
        <span class="brand-name">MadMatcher</span>
      </a>
      <p class="footer-tag">{SITE.tagline}</p>
      <div class="footer-socials">
        <a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" /></svg>
        </a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5V8h3v11zM6.5 6.7a1.8 1.8 0 110-3.5 1.8 1.8 0 010 3.5zM19 19h-3v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V19h-3V8h2.9v1.5h.04A3.2 3.2 0 0114 7.8c3 0 3.6 2 3.6 4.6V19z" /></svg>
        </a>
        <a href={`mailto:${CONTACT.email}`} aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
        </a>
      </div>
    </div>

    {
      columns.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <h4 class="footer-col-title">{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...('external' in link && link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer-base">
    <p>© {year} {SITE.legalName}. All rights reserved.</p>
    <button type="button" class="cookie-prefs" onclick="window.openCookiePrefs && window.openCookiePrefs()">
      Cookie preferences
    </button>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: #c7c7cc;
    padding-block: var(--space-16) var(--space-8);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: var(--space-8);
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-weight: 680;
    font-size: var(--text-lg);
  }
  .brand-mark-img {
    width: 26px;
    height: 26px;
    display: block;
  }
  .footer-tag {
    margin-top: var(--space-4);
    max-width: 30ch;
    color: #9b9ba0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .footer-socials {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    color: #8e8e93;
  }
  .footer-socials a:hover {
    color: #fff;
  }
  .footer-col-title {
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .footer-col a {
    color: #b0b0b6;
    font-size: var(--text-sm);
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: var(--text-xs);
    color: #8e8e93;
  }
  .cookie-prefs {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--text-xs);
    color: #8e8e93;
    cursor: pointer;
  }
  .cookie-prefs:hover {
    color: #fff;
  }
  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
