---
import { NAV, SOCIAL, SITE } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img src="/logo.svg" alt="MadMatcher" class="brand-logo" width="105" height="42" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        href={SOCIAL.github}
        class="gh-link"
        target="_blank"
        rel="noopener"
        aria-label="MadMatcher on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.7.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
        </svg>
        <span>GitHub</span>
      </a>
      <a href="/contact" class="btn btn-accent btn-sm">Talk to us</a>
    </div>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" data-mobile-nav hidden>
    {NAV.map((item) => <a href={item.href} class="mobile-link">{item.label}</a>)}
    <a href={SOCIAL.github} class="mobile-link" target="_blank" rel="noopener">GitHub ↗</a>
    <a href="/contact" class="btn btn-accent">Talk to us</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    /* pull the link box tight to the artwork */
    margin-left: -2px;
  }
  .brand-logo {
    height: 42px;
    width: auto;
    display: block;
  }
  .primary-nav {
    display: flex;
    gap: 0.3rem;
    margin-right: auto;
  }
  .nav-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-soft);
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .nav-link.active {
    color: var(--ink);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-soft);
  }
  .gh-link:hover {
    color: var(--ink);
  }
  .btn-sm {
    padding: 0.55rem 0.95rem;
    font-size: var(--text-sm);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }
  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6) var(--space-6);
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .mobile-link {
    padding: 0.7rem 0;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .primary-nav,
    .gh-link,
    .header-actions .btn {
      display: none;
    }
    .header-actions {
      margin-left: auto;
    }
    .nav-toggle {
      display: flex;
    }
    .mobile-nav[data-open] {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-mobile-nav]');
  toggle?.addEventListener('click', () => {
    const open = menu?.toggleAttribute('data-open');
    toggle.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  });
</script>
