---
/**
 * Cookie consent banner. Analytics is off until the visitor accepts, satisfying
 * EU/UK consent expectations while staying lightweight. The choice is stored in
 * localStorage ("mm_consent") and mirrored to PostHog's own opt-in/opt-out state.
 *
 * window.openCookiePrefs() re-opens the banner (linked from the footer + privacy
 * policy) so visitors can change their mind at any time.
 */
---

<div
  id="consent-banner"
  class="consent-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  hidden
>
  <p class="consent-text">
    We use privacy-friendly analytics cookies to understand how the site is
    used. See our <a href="/privacy#cookies">Privacy Policy</a>.
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-ghost" data-consent="deny">Decline</button>
    <button type="button" class="btn btn-accent" data-consent="accept">Accept</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'mm_consent';
    var banner = document.getElementById('consent-banner');
    if (!banner) return;

    function applyToPostHog(granted) {
      var ph = window.posthog;
      if (!ph || typeof ph.opt_in_capturing !== 'function') return;
      if (granted) ph.opt_in_capturing();
      else ph.opt_out_capturing();
    }

    function setChoice(granted) {
      try {
        localStorage.setItem(KEY, granted ? 'granted' : 'denied');
      } catch (e) {}
      applyToPostHog(granted);
      banner.hidden = true;
    }

    function show() {
      banner.hidden = false;
    }

    // Re-open from the footer / privacy page.
    window.openCookiePrefs = show;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}

    if (stored === 'granted') {
      applyToPostHog(true);
    } else if (stored === 'denied') {
      applyToPostHog(false);
    } else {
      show();
    }

    banner.querySelectorAll('[data-consent]').forEach(function (el) {
      el.addEventListener('click', function () {
        setChoice(el.getAttribute('data-consent') === 'accept');
      });
    });
  })();
</script>

<style>
  .consent-banner {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 200;
    margin-inline: auto;
    max-width: 64rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-6) var(--space-8);
    background: var(--bg-ink, #161617);
    color: #e7e7ea;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }
  /* Author display:flex would otherwise override the [hidden] attribute. */
  .consent-banner[hidden] {
    display: none;
  }
  .consent-text {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .consent-text a {
    color: #fff;
    text-decoration: underline;
  }
  .consent-actions {
    display: flex;
    gap: var(--space-4);
    flex-shrink: 0;
  }
  .consent-banner .btn {
    padding: 0.6rem 1.4rem;
    white-space: nowrap;
  }
  .consent-banner .btn-ghost {
    background: transparent;
    color: #e7e7ea;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .consent-banner .btn-ghost:hover {
    border-color: #fff;
    color: #fff;
  }
  @media (max-width: 720px) {
    .consent-banner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-5, 1.25rem) var(--space-6);
    }
    .consent-text {
      max-width: none;
    }
    .consent-actions {
      justify-content: flex-end;
    }
  }
</style>
